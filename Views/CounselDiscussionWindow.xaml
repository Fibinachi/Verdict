<Window x:Class="Verdict.Views.CounselDiscussionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Counsel Discussion (Sidebar)" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#2C3E50">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PRIVATE COUNSEL DISCUSSION" Foreground="#E67E22" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#1A252F" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DiscussionLog" Text="{Binding DiscussionTranscript}" Foreground="#ECF0F1" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10">
            <TextBlock Text="Topic / Direction:" Foreground="#BDC3C7" Margin="0,0,0,5"/>
            <TextBox x:Name="TopicInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#34495E" Foreground="White" BorderThickness="0" Padding="5"/>
        </StackPanel>

        <UniformGrid Grid.Row="3" Columns="2">
            <Button x:Name="SimulateButton" Content="Simulate Discussion" Click="Simulate_Click" Margin="0,0,5,0" Background="#2980B9" Foreground="White" Padding="10"/>
            <Button Content="Close &amp; Record to Sidebar" Click="Close_Click" Margin="5,0,0,0" Background="#7F8C8D" Foreground="White"/>
        </UniformGrid>
    </Grid>
</Window>
