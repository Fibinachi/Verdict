<Window x:Class="Verdict.Views.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Verdict.Converters"
        mc:Ignorable="d"
        Title="LLM Model Configuration" Height="700" Width="650"
        WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <Window.Resources>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Global Settings Section -->
        <GroupBox Header="Global Settings (applies to all models)" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Temperature:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding GlobalTemperature}" TickFrequency="0.1" TickPlacement="BottomRight"
                        IsSnapToTickEnabled="False" Margin="0,0,10,5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GlobalTemperature, StringFormat={}{0:F2}}" 
                           VerticalAlignment="Center" Width="40" Margin="0,0,0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Tokens:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GlobalMaxTokens}" Margin="0,0,10,5" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120"/>
            </Grid>
        </GroupBox>

        <!-- Model List and Actions -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Model List -->
            <GroupBox Header="Configured Models" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Provider}" FontSize="10" Foreground="Gray"/>
                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#2ECC71"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </GroupBox>

            <!-- Actions -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="Add Model..." Click="AddModel_Click" Margin="0,0,0,5" Padding="10,5"/>
                <Button Content="Configure..." Click="ConfigureModel_Click" Margin="0,0,0,5" Padding="10,5"
                        IsEnabled="{Binding SelectedModel, Converter={StaticResource NullToBoolConverter}}"/>
                <Button Content="Delete Model" Click="DeleteModel_Click" Margin="0,0,0,5" Padding="10,5" 
                        IsEnabled="{Binding SelectedModel, Converter={StaticResource NullToBoolConverter}}"/>
                <Separator Margin="0,10,0,10"/>
                <Button Content="🔄 Refresh Folder" Click="RefreshFolder_Click" Margin="0,0,0,5" Padding="10,5" Background="#3498DB" Foreground="White"/>
                <Button Content="_Model Weights..." Click="OpenWeights_Click" Margin="0,0,0,5" Padding="10,5"/>
                <Button Content="💾 Save Selected" Click="SaveToFolder_Click" Margin="0,0,0,20" Padding="10,5" 
                        IsEnabled="{Binding SelectedModel, Converter={StaticResource NullToBoolConverter}}" Background="#27AE60" Foreground="White"/>
                
                <TextBlock Text="Quick Summary:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="White" 
                        IsEnabled="{Binding SelectedModel, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedModel.FriendlyName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedModel.Provider}" Margin="0,2,0,5"/>
                        <TextBlock Text="Status:" FontSize="10" Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedModel.Status}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bias Settings Section -->
        <GroupBox Header="Bias Weight Configuration" Grid.Row="2" Margin="0,10,0,10">
            <Canvas>
                <Slider x:Name="AgeSlider" Canvas.Left="80" Canvas.Top="5" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding AgeBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Age:" Canvas.Left="0" Canvas.Top="10" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AgeBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="10" Width="40"/>

                <Slider x:Name="GenderSlider" Canvas.Left="80" Canvas.Top="40" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding GenderBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Gender:" Canvas.Left="0" Canvas.Top="45"/>
                <TextBlock Text="{Binding GenderBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="45" Width="40"/>

                <Slider x:Name="EducationSlider" Canvas.Left="80" Canvas.Top="70" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding EducationBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Education Level:" Canvas.Left="0" Canvas.Top="75"/>
                <TextBlock Text="{Binding EducationBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="75" Width="40"/>

                <Slider x:Name="IncomeSlider" Canvas.Left="80" Canvas.Top="100" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding IncomeBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Income Level:" Canvas.Left="0" Canvas.Top="105"/>
                <TextBlock Text="{Binding IncomeBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="105" Width="40"/>

                <Slider x:Name="PoliticalSlider" Canvas.Left="80" Canvas.Top="130" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding PoliticalBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Political Affiliation:" Canvas.Left="0" Canvas.Top="135"/>
                <TextBlock Text="{Binding PoliticalBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="135" Width="40"/>

                <Slider x:Name="EthnicitySlider" Canvas.Left="80" Canvas.Top="160" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding EthnicityBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Ethnicity:" Canvas.Left="0" Canvas.Top="165"/>
                <TextBlock Text="{Binding EthnicityBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="165" Width="40"/>

                <Slider x:Name="ReligionSlider" Canvas.Left="80" Canvas.Top="190" Width="200"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding ReligionBiasWeight}" TickFrequency="0.1" TickPlacement="BottomRight"/>
                <TextBlock Text="Religion:" Canvas.Left="0" Canvas.Top="195"/>
                <TextBlock Text="{Binding ReligionBiasWeight, StringFormat={}{0:F2}}" Canvas.Left="290" Canvas.Top="195" Width="40"/>

                <StackPanel Canvas.Left="350" Canvas.Top="5" Width="150">
                    <Button Content="Set Defaults" Click="SetBiasDefaults_Click" Width="100" Margin="0,0,10,0"/>
                    <Button Content="Reset to Defaults" Click="ResetBiasDefaults_Click" Width="120"/>
                </StackPanel>
            </Canvas>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Width="75" Margin="0,0,5,0"/>
            <Button Content="Cancel" IsCancel="True" Width="75"/>
        </StackPanel>
    </Grid>
</Window>