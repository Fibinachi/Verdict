<Window x:Class="Verdict.Views.JurorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Verdict.Models"
        xmlns:local="clr-namespace:Verdict.Views"
        mc:Ignorable="d"
        Title="Juror Report" Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1B2631" Foreground="White"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Strength-to-Color Converter -->
        <local:StrengthToColorConverter x:Key="StrengthToColor"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E67E22"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MemoryItemBorder" TargetType="Border">
            <Setter Property="Background" Value="#243342"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="MemoryContent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TimestampText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StrengthBarBorder" TargetType="Border">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#1A252F"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StrengthBarFill" TargetType="Border">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header with juror name, role, and demographics summary -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding Role}" FontSize="14" Foreground="#E67E22" Margin="0,2,0,0"/>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Style="{StaticResource InfoLabel}" Text="Age:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Age}"/>
                <TextBlock Style="{StaticResource InfoLabel}" Text="Gender:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Gender}"/>
                <TextBlock Style="{StaticResource InfoLabel}" Text="Race:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Race}"/>
                <TextBlock Style="{StaticResource InfoLabel}" Text="Occupation:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding Occupation}"/>
                <TextBlock Style="{StaticResource InfoLabel}" Text="Education:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding EducationLevel}"/>
                <TextBlock Style="{StaticResource InfoLabel}" Text="Income:"/>
                <TextBlock Style="{StaticResource InfoValue}" Text="{Binding IncomeLevel}"/>
            </WrapPanel>
        </StackPanel>

        <!-- Row 1: Sentiment/Verdict summary section -->
        <Border Grid.Row="1" Background="#243342" BorderBrush="#34495E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Sentiment" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center"
                               Text="{Binding Sentiment, StringFormat={}{0:P0}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Verdict Lean" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center"
                               Text="{Binding VerdictLean, StringFormat={}{0:P0}}"/>
                    <TextBlock x:Name="LeanDirectionLabel" FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center" Text="towards Plaintiff"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Valuation" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#F1C40F" HorizontalAlignment="Center"
                               Text="{Binding Valuation}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Bias" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"
                               Text="{Binding Bias, StringFormat={}{0:N2}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Separator -->
        <Border Grid.Row="2" Height="1" Background="#34495E" Margin="0,0,0,8"/>

        <!-- Row 3: TabControl with Trial Memories and Background Memories -->
        <TabControl Grid.Row="3" Background="#1B2631" BorderBrush="#34495E" BorderThickness="1">
            <TabItem Header="Trial Memories" Style="{StaticResource TabHeaderStyle}">
                <Grid Background="#1B2631" Margin="4">
                    <ListBox ItemsSource="{Binding TrialEvents}" 
                             Background="Transparent" 
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AlternationCount="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:MemoryEntry">
                                <Border Style="{StaticResource MemoryItemBorder}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MemoryContent}" Text="{Binding Content}"/>
                                        <Border Style="{StaticResource StrengthBarBorder}">
                                            <Border Style="{StaticResource StrengthBarFill}"
                                                    Width="{Binding Strength, Converter={StaticResource StrengthToColor}, ConverterParameter=Width}"
                                                    Background="{Binding Strength, Converter={StaticResource StrengthToColor}}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource TimestampText}" Text="{Binding Timestamp, StringFormat={}{0:g}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Background Memories" Style="{StaticResource TabHeaderStyle}">
                <Grid Background="#1B2631" Margin="4">
                    <ListBox ItemsSource="{Binding Memories}" 
                             Background="Transparent" 
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AlternationCount="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:MemoryEntry">
                                <Border Style="{StaticResource MemoryItemBorder}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MemoryContent}" Text="{Binding Content}"/>
                                        <Border Style="{StaticResource StrengthBarBorder}">
                                            <Border Style="{StaticResource StrengthBarFill}"
                                                    Width="{Binding Strength, Converter={StaticResource StrengthToColor}, ConverterParameter=Width}"
                                                    Background="{Binding Strength, Converter={StaticResource StrengthToColor}}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource TimestampText}" Text="{Binding Timestamp, StringFormat={}{0:g}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Row 4: Close button -->
        <Button Grid.Row="4" Style="{StaticResource CloseButton}" Click="Close_Click" Content="Close"/>
    </Grid>
</Window>
