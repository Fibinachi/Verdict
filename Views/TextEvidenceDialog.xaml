<Window x:Class="Verdict.Views.TextEvidenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Submit Text Evidence" Height="650" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#1B2631" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Text Evidence" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Fill out the evidence text and factors. Optionally ask the reporter questions; answers will be appended into the evidence text before creating the exhibit." Margin="0,0,0,8" Foreground="#BDC3C7"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Evidence Text" FontWeight="SemiBold" Margin="0,5,0,4"/>
                <TextBox x:Name="EvidenceTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="160"/>

                <TextBlock Text="Evidence Factors" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <TextBox x:Name="EvidenceFactorsBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="110"/>

                <Separator Margin="0,16,0,16" Background="#34495E"/>

                <TextBlock Text="Reporter Q&amp;A (optional)" FontWeight="SemiBold" Margin="0,5,0,4"/>
                <TextBox x:Name="ReporterQuestionsBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="90"/>
                <TextBlock Text="Tip: put your reporter questions here; the reporter will answer and those answers will be appended to the evidence text." Foreground="#BDC3C7" FontSize="12" Margin="0,4,0,0"/>

                <Separator Margin="0,16,0,16" Background="#34495E"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Offering Attorney" FontWeight="SemiBold" Margin="0,5,0,4"/>
                        <TextBox x:Name="OfferingAttorneyBox" Text=""/>
                    </StackPanel>

                    <!-- Balloon style radio buttons (click bubble next to side label) -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Offered By" FontWeight="SemiBold" Margin="0,5,0,4"/>

                        <RadioButton x:Name="OfferedByPlaintiffCheck" Content="Plaintiff / Prosecutor" IsChecked="True"
                                     GroupName="OfferingSide" Margin="0,0,0,6"
                                     FontWeight="SemiBold"/>
                        <RadioButton x:Name="OfferedByDefenseCheck" Content="Defense" IsChecked="False"
                                     GroupName="OfferingSide" Margin="0,0,0,0"
                                     FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Add as Exhibit will create a new exhibit and broadcast it to agents." Foreground="#BDC3C7" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Add as Exhibit" Width="140" Background="#2980B9" Foreground="White" FontWeight="Bold" Click="Add_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
