<Window x:Class="Verdict.Views.JurorLeanChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Juror Lean Over Time" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8F8F8">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Verdict Lean Trajectory — All Jurors"/>
            <TextBlock FontSize="12" Foreground="#666" Text="X-axis: trial phase/deliberation round  |  Y-axis: verdict lean (0.0 = Defense, 1.0 = Prosecution/Plaintiff)"/>
        </StackPanel>

        <!-- Chart Canvas -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4">
            <Canvas x:Name="ChartCanvas" Margin="60,20,20,40" ClipToBounds="True"/>
        </Border>

        <!-- Legend -->
        <ItemsControl Grid.Row="2" x:Name="LegendPanel" Margin="60,8,20,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <Rectangle Width="14" Height="3" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="11" Text="{Binding Name}" Foreground="#444"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
