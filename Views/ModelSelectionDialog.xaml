<Window x:Class="Verdict.Views.ModelSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Verdict.Views"
        mc:Ignorable="d"
        Title="Select Model" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Available Models:" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <ListBox x:Name="ModelList" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="ErrorMessage" Foreground="Red" Visibility="Collapsed" 
                       Grid.Row="1" TextAlignment="Center"/>
        </Grid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Width="75" Margin="0,0,10,0"/>
            <Button Content="Select" Click="SelectModel_Click" Width="75" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>