<Window x:Class="Verdict.Views.ModelDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Verdict.Views"
        mc:Ignorable="d"
        Title="Configure Model" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Provider, StringFormat='Configure {0} Model'}" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" x:Name="ApiKeyInstruction" Margin="0,0,0,5">
            <Hyperlink x:Name="ApiKeyLink" NavigateUri="" RequestNavigate="Hyperlink_RequestNavigate">
                Get your API key here
            </Hyperlink>
        </TextBlock>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,10">
            <ContentControl x:Name="DynamicFieldsControl"/>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="TestButton" Content="Test Connection" Click="Test_Click" 
                        Width="120" Margin="0,0,10,0"/>
                
                <TextBlock x:Name="StatusTextBlock" Text="{Binding Status}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DeleteModelButton" Content="Delete Local" Click="DeleteModel_Click" 
                        Width="90" Margin="0,0,10,0" Padding="6,4" Visibility="Collapsed" ToolTip="Delete downloaded model files to free space or fix partial downloads."/>
                <Button x:Name="DownloadButton" Content="Download" Click="Download_Click" 
                        Width="90" Margin="0,0,10,0" Padding="6,4" Visibility="Collapsed"/>
                <Button x:Name="LoadModelsButton" Content="Browse..." Click="LoadModels_Click" 
                        Width="75" Margin="0,0,10,0" Padding="6,4" Visibility="Collapsed"/>
                <Button Content="Save" Click="Save_Click" Width="65" Padding="6,4" IsDefault="True"/>
            </StackPanel>
        </Grid>
        
        <!-- Download size preview & progress section -->
        <Border Grid.Row="4" x:Name="DownloadProgressSection" Visibility="Collapsed" Margin="0,8,0,0" Padding="8" BorderBrush="#FF4CAF50" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="DownloadSizePreview" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#E67E22" Visibility="Collapsed"/>
                    <TextBlock x:Name="DownloadStatusText" Text="Downloading model..." FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="DownloadProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="#FF10893E" Background="#FFE0E0E0"/>
                <TextBlock x:Name="DownloadFileText" Text="" Margin="0,4,0,0" FontSize="11" Foreground="Gray"/>
            </StackPanel>
        </Border>
        
        <!-- Error text box - overlays the button row (Row 3) -->
        <TextBox Grid.Row="3" Grid.RowSpan="2" x:Name="ErrorTextBox" 
                 Visibility="Collapsed"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 MinHeight="60"
                 MaxHeight="120"
                 Margin="0,0,0,8"
                 Padding="4"
                 BorderBrush="Red"
                 BorderThickness="1"
                 Background="#FFF8F0"
                 Foreground="#CC0000"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 VerticalAlignment="Bottom"/>
        
        <!-- Loading spinner and error message -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" 
              Visibility="Collapsed" x:Name="LoadingOverlay">
            <Border Background="White" CornerRadius="5" Padding="20" 
                    BorderBrush="#CCCCCC" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="LoadingSpinner" Text="Loading models..." 
                               FontSize="14" Margin="0,0,0,10"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="10"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <TextBlock x:Name="ErrorMessage" Grid.Row="2" Grid.ColumnSpan="2" 
                   Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,50" Visibility="Collapsed" Width="400" TextWrapping="Wrap"/>
    </Grid>
</Window>