
<Window x:Class="Verdict.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Verdict"
        xmlns:conv="clr-namespace:Verdict.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="950" Width="1500"
        Background="#2C3E50">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InvBool"/>
        <conv:EnumMatchConverter x:Key="EnumMatchConverter"/>
        <!-- Seat Style - compact for better visibility -->
        <Style x:Key="SeatBase" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#7F8C8D"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="StatusWindow" TargetType="Border">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#1A252F"/>
            <Setter Property="BorderBrush" Value="#34495E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        
        <Style x:Key="RoleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E67E22"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="1,0,3,0"/>
        </Style>

        <!-- Agent Seat DataTemplate -->
        <DataTemplate x:Key="AgentSeatTemplate">
            <Grid Margin="5">
                <Border Style="{StaticResource SeatBase}" Background="#34495E" AllowDrop="True" Drop="AgentSeat_Drop" ContextMenuOpening="AgentSeat_ContextMenuOpening" IsHitTestVisible="True">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add Agent..." Click="AddAgent_Click"/>
                            <MenuItem Header="Edit Profile..." Click="AddAgent_Click"/>
                            <MenuItem Header="Generate Juror..." Click="GenerateLikelyJuror_Click" Tag="{Binding}"/>
                            <MenuItem Header="Chat" Click="AgentChat_Click" Tag="{Binding}"/>
                            <MenuItem Header="Juror Report" Click="JurorReport_Click" Tag="{Binding}"/>
                            <MenuItem Header="Save Character" Click="ExportCharacter_Click"/>
                            <MenuItem Header="Delete" Click="DeleteAgent_Click" Foreground="Red"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <TextBlock Text="+" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                        <!-- Small avatar (static, compilation-safe) -->
                        <Grid Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="24" Height="24">
                            <Ellipse Fill="#2C3E50" Stroke="#7F8C8D" StrokeThickness="1"/>

                            <!-- Hat (red) -->
                            <Polygon Points="12,5 16,12 8,12" Fill="#E74C3C"/>
                            <Rectangle Width="18" Height="4" Fill="#E74C3C" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0"/>
                            <!-- Brim -->
                            <Rectangle Width="2" Height="3" Fill="#F1C40F" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>

                            <!-- age hint: gray hair line -->
                            <Rectangle Width="14" Height="2" Fill="#95A5A6" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>

                            <!-- fallback initials (tiny) -->
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatusWindow}" 
                        Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Margin="-50,-25,-50,-25">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RoleLabel}" Text="{Binding Name}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanVote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Sentiment, StringFormat={}{0:P0}}" FontSize="10" Foreground="#2ECC71"/>
                            <TextBlock Style="{StaticResource MetricLabel}" Text=" L:"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding VerdictLean, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanVote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="$:"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Valuation}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        
        <!-- Special DataTemplate for Clerk/Reporter with document intake functionality -->
        <DataTemplate x:Key="ClerkSeatTemplate">
            <StackPanel Orientation="Vertical" Margin="5">
                <Border Style="{StaticResource SeatBase}" Background="#27AE60" MouseLeftButtonDown="ClerkSeat_Click" Cursor="Hand">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Edit Profile..." Click="EditReporterProfile_Click"/>
                            <Separator/>
                            <MenuItem Header="Submit Document as Evidence..." Click="ClerkSeat_Click"/>
                            <MenuItem Header="Submit Text Evidence..." Click="ClerkSeat_SubmitTextEvidence_Click"/>

                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" 
                           HorizontalAlignment="Center" 
                           Foreground="White" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Margin="0,3,0,0" />
                <Border Style="{StaticResource StatusWindow}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RoleLabel}" Text="{Binding Role}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="Docs:"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding DocumentCount, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Foreground="Black">
            <MenuItem Header="_File">
                <MenuItem Header="_New Case" Click="NewCase_Click"/>
                <MenuItem Header="_Open Case..." Click="OpenCase_Click"/>
                <MenuItem Header="_Save Case" Click="SaveSimulation_Click"/>
                <MenuItem Header="Save Case _As..." Click="SaveCaseAs_Click"/>
                <Separator/>
                <MenuItem Header="_Default Cases">
                    <MenuItem Header="Rebranded O.J. Trial" Click="DefaultCase_OJ_Click"/>
                    <MenuItem Header="Rebranded Sacco &amp; Vanzetti" Click="DefaultCase_SaccoVanzetti_Click"/>
                    <MenuItem Header="Rebranded Exxon Trial" Click="DefaultCase_Exxon_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Recent Files" x:Name="RecentFilesMenu" IsEnabled="False">
                    <MenuItem.Visibility>
                        <Visibility>Collapsed</Visibility>
                    </MenuItem.Visibility>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Import Transcript..." Click="ImportTranscript_Click"/>
                <MenuItem Header="Export _PDF Report" Click="GenerateReport_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Stage">
                <MenuItem Header="_Discovery" Click="SetTrialPhase_Discovery_Click" IsChecked="{Binding CurrentCase.TrialPhase, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Discovery}" IsCheckable="True"/>
                <MenuItem Header="_Pretrial" Click="SetTrialPhase_Pretrial_Click" IsChecked="{Binding CurrentCase.TrialPhase, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Pretrial}" IsCheckable="True"/>
                <MenuItem Header="_Trial" Click="SetTrialPhase_Trial_Click" IsChecked="{Binding CurrentCase.TrialPhase, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Trial}" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="_Opening Statements" Click="SetCourtPhase_OpeningStatements_Click"/>
                <MenuItem Header="_Witness Testimony" Click="SetCourtPhase_WitnessTestimony_Click"/>
                <MenuItem Header="_Cross Examination" Click="SetCourtPhase_CrossExamination_Click"/>
                <MenuItem Header="_Party Statements" Click="SetCourtPhase_PartyStatements_Click"/>
                <MenuItem Header="_Closing Arguments" Click="SetCourtPhase_ClosingArguments_Click"/>
                <MenuItem Header="_Jury Deliberation" Click="SetCourtPhase_JuryDeliberation_Click"/>
            </MenuItem>
            <MenuItem Header="_Case">
                <MenuItem Header="_Import Transcript..." Click="ImportTranscript_Click"/>
                <MenuItem Header="E_xtract Entities from Transcript" Click="ExtractEntities_Click"/>
                <MenuItem Header="_Exhibit List" Click="ExhibitList_Click"/>
                <MenuItem Header="Re-evaluate Evidence" Click="ReevaluateEvidence_Click"
                          ToolTip="Replay all admitted exhibits through each juror's current psychology"/>
                <Separator/>
                <MenuItem Header="_Case Settings" Click="CaseSettings_Click"/>
                <!-- Removed Default Case Settings from here - it belongs in Settings menu -->
            </MenuItem>
            <MenuItem Header="_Agents">
                <MenuItem Header="_Initiate Counsel Discussion" Click="CounselDiscussion_Click"/>
                <MenuItem Header="_Attorney-Client Consultation" Click="ClientConsultation_Click"/>
                <Separator/>
                <MenuItem Header="_Dynamic Role Assignment" Click="DynamicRoleAssignment_Click"/>
                <Separator/>
                <MenuItem Header="_Load Agent..." Click="LoadAgent_Click"/>
                <MenuItem Header="_Build Agent" Click="BuildAgent_Click"/>
                <MenuItem Header="_Design Prompts" Click="DesignPrompts_Click"/>
                <MenuItem Header="_Batch Update Prompts" Click="BatchUpdatePrompts_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Case Settings" Click="CaseSettings_Click"/>
                <MenuItem Header="_Default Case Settings" Click="DefaultCaseSettings_Click"/>
                <Separator/>
                <MenuItem Header="_General Settings" Click="GeneralSettings_Click"/>
                <MenuItem Header="_LLM Configuration" Click="LLMConfiguration_Click"/>
                <MenuItem Header="_Model Weights" Click="ModelWeights_Click"/>
                <MenuItem Header="_Courtroom Layout" Click="CourtroomLayoutSettings_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Verdict" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#1A252F" Foreground="White" Padding="10,5">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="COURT STAGE:" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentDebateStageDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2ECC71"/>
                    <Button Content="DELIBERATE (Turn)" Click="AdvanceStage_Click" Margin="15,0,0,0" Padding="8,2" Background="#2980B9" Foreground="White" FontSize="10"/>

                </StackPanel>
            </StatusBarItem>
            <Separator Margin="20,0"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LIKELY JURY VERDICT:" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding LikelyVerdict, Mode=OneWay}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="20,0"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LIABILITY SCORE:" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,10,0"/>
                    <ProgressBar Value="{Binding JuryLiabilityAverage, Mode=OneWay}" Minimum="0" Maximum="1" Width="150" Height="15" Foreground="#2ECC71" Background="#34495E"/>
                    <TextBlock Text="{Binding JuryLiabilityAverage, Mode=OneWay, StringFormat=P0}" Margin="10,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Bench -->
                <RowDefinition Height="Auto"/> <!-- Reply Window -->
                <RowDefinition Height="*"/>    <!-- Floor Area -->
                <RowDefinition Height="Auto"/> <!-- Prompt Entry -->
            </Grid.RowDefinitions>

            <!-- Bench Area -->
            <Grid Grid.Row="0">
                    <ItemsControl ItemsSource="{Binding JudgeArea}" HorizontalAlignment="Center">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplateSelector>
                        <local:ClerkTemplateSelector 
                            AgentTemplate="{StaticResource AgentSeatTemplate}" 
                            ClerkTemplate="{StaticResource ClerkSeatTemplate}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
                <Button Content="ADMIT EVIDENCE" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Background="#2980B9" 
                        Foreground="White" 
                        Padding="10,5" 
                        FontWeight="Bold" 
                        Click="AddEvidence_Click" 
                        Margin="0,0,20,0"/>
            </Grid>

            <!-- Reply Window -->
            <Border Grid.Row="1" Background="#1A252F" BorderBrush="#34495E" BorderThickness="2" Padding="15" CornerRadius="10" Margin="0,20">
                <DockPanel>
                    <TextBlock Text="COURT RECORD / REPLIES" DockPanel.Dock="Top" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,0,10" FontSize="12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="100">
                        <TextBlock x:Name="ReplyOutput" Text="{Binding TranscriptOutput}" Foreground="#ECF0F1" TextWrapping="Wrap" FontSize="14"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main Floor Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Jury Box (12 Jurors in 4x3 + 2 Alternates below) -->
                <Border Grid.Column="0" Background="#34495E" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="JURY BOX (12+2)" Foreground="#BDC3C7" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding Jurors}" ItemTemplate="{StaticResource AgentSeatTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- Alternate Jurors below the main jury -->
                        <ItemsControl ItemsSource="{Binding AlternateJurors}" ItemTemplate="{StaticResource AgentSeatTemplate}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button Content="GENERATE JURY" 
                                Click="GenerateJury_Click" 
                                Margin="0,10,0,0" 
                                Padding="5,2"
                                Background="#2ECC71" 
                                Foreground="White" 
                                FontSize="9"
                                Width="120"/>
                    </StackPanel>
                </Border>
                <!-- Observer Box (Max 6 in 2x3) -->
                <Border Grid.Column="2" Background="#34495E" CornerRadius="5" Padding="15">
                    <StackPanel>
                        <TextBlock Text="OBSERVERS (MAX 6)" Foreground="#BDC3C7" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding Gallery}" ItemTemplate="{StaticResource AgentSeatTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Counsel Area -->
                <Grid Grid.Column="1" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Defense Table -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DEFENSE TABLE" Foreground="#BDC3C7" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="14"/>
                        <ItemsControl ItemsSource="{Binding DefenseTeam}" ItemTemplate="{StaticResource AgentSeatTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Width="60" Height="40" Background="#D35400" Content="PODIUM" Foreground="White" FontWeight="Bold" Click="Podium_Click" VerticalAlignment="Center"/>
                    
                    <!-- Plaintiff/Prosecution Table -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="PLAINTIFF TABLE" Foreground="#BDC3C7" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="14"/>
                        <ItemsControl ItemsSource="{Binding ProsecutionTeam}" ItemTemplate="{StaticResource AgentSeatTemplate}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Prompt Entry -->
            <Border Grid.Row="3" Background="#1A252F" BorderBrush="#34495E" BorderThickness="2" Padding="15" CornerRadius="10" Margin="0,20,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="INPUT PROMPT" Grid.Row="0" Foreground="#E67E22" FontWeight="Bold" Margin="0,0,0,10" FontSize="12"/>

                    <Grid Grid.Row="1" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput"
                                  Grid.Column="0"
                                  Background="#2C3E50"
                                  Foreground="#ECF0F1"
                                 BorderThickness="0"
                                 Padding="10"
                                 FontSize="14"
                                 MinHeight="60"
                                 VerticalAlignment="Stretch"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 CaretBrush="#E67E22"
                                 KeyDown="ChatInput_KeyDown"/>

                        <Button Content="SEND"
                                Grid.Column="1"
                                Click="SendMessage_Click"
                                Width="80"
                                Margin="10,0,0,0"
                                Background="#E67E22"
                                Foreground="White"
                                FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>